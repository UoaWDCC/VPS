# Copy this file to .env and fill it in. Never commit .env.

# MongoDB
MONGODB_USER=
MONGODB_PASSWORD=

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_STORAGE_BUCKET=

# Server
PORT=5001

# AI assistant (optional). Without a key and a model it says it isn't set up.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# OPENROUTER_FAST_MODEL=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# AI_DAILY_LIMIT=200
# AI_MAX_OUTPUT_TOKENS=4096
# AI_MAX_INPUT_CHARS=600000
# AI_TIMEOUT_MS=120000
# AI_LOG_CONTENT=false
